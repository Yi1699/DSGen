# Track the current source directories and project entry files.
/*
!/.gitignore
!/README.md
!/environment.yaml
!/main.py
!/bldm/
!/configs/
!/ldm/
!/src/

# Runtime data and model directories (also match symlinks).
/dataset
/datasets
/ckpt
/demo
/src/taming-transformers/data/
/src/taming-transformers/assets/
/src/clip/CLIP.png
/src/clip/notebooks/
/ldm/modules/image_degradation/utils/test.png

# Training, evaluation, inference results and downloaded models.
log/
logs/
lightning_logs/
wandb/
runs/
output/
outputs/
result/
results/
checkpoints/
ckpt/
weights/
pretrained/
pretrained_models/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.h5
*.hdf5
*.bin
*.npy
*.npz
*.pkl
*.pickle
*.parquet
*.arrow

# Dataset archives; keep CLIP's required *.txt.gz tokenizer vocabulary.
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Python caches, build products and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.torch/
.ipynb_checkpoints/
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Logs and machine-specific files.
*.log
nohup.out
events.out.tfevents.*
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
